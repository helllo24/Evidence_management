<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.sql.*" %><%ResultSet row=(ResultSet)request.getAttribute("caseRow");boolean edit=row!=null; %><!DOCTYPE html><html><head><title>Case Form</title><link rel="stylesheet" href="style.css"></head><body><%@ include file="header.jsp" %><h1><%=edit?"Edit Case":"Register Case"%></h1><div class="card"><form method="post" action="cases"><%if(edit){%><input type="hidden" name="id" value="<%=row.getInt("id")%>"><%}%><label>Case Number</label><input name="case_no" required value="<%=edit?row.getString("case_no"):""%>"><label>Case Title</label><input name="title" required value="<%=edit?row.getString("title"):""%>"><label>Description</label><textarea name="description"><%=edit?row.getString("description"):""%></textarea><label>Category</label><input name="category" value="<%=edit?row.getString("category"):""%>"><label>Status</label><select name="status"><%String[] sts={"OPEN","IN_PROGRESS","UNDER_REVIEW","CLOSED"};for(String x:sts){%><option <%=edit&&x.equals(row.getString("status"))?"selected":""%>><%=x%></option><%}%></select><label>Priority</label><select name="priority"><%String[] ps={"LOW","MEDIUM","HIGH"};for(String x:ps){%><option <%=edit&&x.equals(row.getString("priority"))?"selected":""%>><%=x%></option><%}%></select><label>Investigator</label><input name="investigator" value="<%=edit?row.getString("investigator"):""%>"><button>Save Case</button> <a href="cases">Cancel</a></form></div></div></body></html>
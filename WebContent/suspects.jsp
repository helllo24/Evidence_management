<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.sql.*" %><!DOCTYPE html><html><head><title>Suspects</title><link rel="stylesheet" href="style.css"></head><body><%@ include file="header.jsp" %><h1>Suspect Information</h1><div class="card"><form method="post" action="suspects"><label>Case ID</label><input type="number" name="case_id" required placeholder="Numeric case ID"><label>Full Name</label><input name="full_name" required><label>Age</label><input type="number" name="age"><label>Gender</label><input name="gender"><label>Contact</label><input name="contact"><label>Address</label><textarea name="address"></textarea><label>Notes</label><textarea name="notes"></textarea><button>Add Suspect</button></form></div><div class="card table-wrap"><table><tr><th>Name</th><th>Case</th><th>Age</th><th>Contact</th><th>Notes</th><th></th></tr><%ResultSet rs=(ResultSet)request.getAttribute("rows");while(rs.next()){%><tr><td><%=rs.getString("full_name")%></td><td><%=rs.getString("case_no")%></td><td><%=rs.getString("age")%></td><td><%=rs.getString("contact")%></td><td><%=rs.getString("notes")%></td><td><form method="post"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=rs.getInt("id")%>"><button class="danger">Delete</button></form></td></tr><%}%></table></div></div></body></html>
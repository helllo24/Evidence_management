<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><title>Dashboard</title><link rel="stylesheet" href="style.css"></head><body><%@ include file="header.jsp" %><h1>Dashboard</h1><p class="muted">Centralized investigation records and digital evidence workspace.</p><div class="grid"><div class="card">Cases<div class="metric">${casesCount}</div></div><div class="card">Suspects<div class="metric">${suspectsCount}</div></div><div class="card">Evidence items<div class="metric">${evidenceCount}</div></div><div class="card">Reports<div class="metric">${reportsCount}</div></div></div><div class="card"><h3>Workflow</h3>Register a case → Add suspect details → Upload evidence → Record investigation report → Update case status.</div></div></body></html>
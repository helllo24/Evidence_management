<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.sql.*" %><!DOCTYPE html><html><head><title>Evidence</title><link rel="stylesheet" href="style.css"></head><body><%@ include file="header.jsp" %><h1>Digital Evidence</h1><div class="card"><form method="post" action="evidence" enctype="multipart/form-data"><label>Case ID (numeric)</label><input type="number" name="case_id" required><label>Evidence Name</label><input name="evidence_name" required><label>Evidence Type</label><input name="evidence_type" placeholder="Screenshot / PDF / Document"><label>Description</label><textarea name="description"></textarea><label>File (max 10 MB)</label><input type="file" name="file"><button>Upload Evidence</button></form></div><div class="card table-wrap"><table><tr><th>Evidence</th><th>Case</th><th>Type</th><th>Original file</th><th>SHA-256</th><th>Uploaded</th></tr><%ResultSet rs=(ResultSet)request.getAttribute("rows");while(rs.next()){%><tr><td><%=rs.getString("evidence_name")%></td><td><%=rs.getString("case_no")%></td><td><%=rs.getString("evidence_type")%></td><td><%=rs.getString("original_filename")%></td><td class="small"><%=rs.getString("sha256")%></td><td><%=rs.getString("uploaded_at")%></td></tr><%}%></table></div></div></body></html>
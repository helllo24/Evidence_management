<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.sql.*" %><!DOCTYPE html><html><head><title>Reports</title><link rel="stylesheet" href="style.css"></head><body><%@ include file="header.jsp" %><h1>Investigation Reports</h1><div class="card"><form method="post" action="reports"><label>Case ID (numeric)</label><input type="number" name="case_id" required><label>Report Title</label><input name="report_title" required><label>Author</label><input name="author"><label>Report Details</label><textarea name="report_text" rows="7" required></textarea><button>Save Report</button></form></div><div class="card table-wrap"><table><tr><th>Title</th><th>Case</th><th>Author</th><th>Date</th><th>Report</th><th></th></tr><%ResultSet rs=(ResultSet)request.getAttribute("rows");while(rs.next()){%><tr><td><%=rs.getString("report_title")%></td><td><%=rs.getString("case_no")%></td><td><%=rs.getString("author")%></td><td><%=rs.getString("created_at")%></td><td><%=rs.getString("report_text")%></td><td><form method="post"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<%=rs.getInt("id")%>"><button class="danger">Delete</button></form></td></tr><%}%></table></div></div></body></html>